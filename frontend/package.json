{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test",
    "test:e2e:debug": "node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test --debug",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit --project tsconfig.app.json",
    "type-check:unit": "vue-tsc --noEmit --project tsconfig.vitest.json",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "generate-client": "openapi-ts -s",
    "generate-changelog": "tsx scripts/generate-changelog.ts",
    "generate-e2e-coverage": "tsx scripts/generate-e2e-coverage.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vee-validate/zod": "^4.15.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "embla-carousel-vue": "^8.6.0",
    "flag-icons": "^7.5.0",
    "motion-v": "^2.3.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.1",
    "simple-icons": "^16.27.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-advanced-cropper": "^2.8.9",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "~1.62.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "markdown-it": "^14.3.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "js-yaml@4": "^4.3.0"
    }
  }
}
