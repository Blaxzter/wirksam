{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    // The node22 base plus the DOM: callbacks handed to page.evaluate() and
    // waitForFunction() run in the browser and use document, window and co.
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["./**/*"]
}
