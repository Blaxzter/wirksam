# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5555
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:4173,http://localhost:5555,https://localhost,https://localhost:5555,http://localhost.tiangolo.com"

# Authentication
# Signing key for the HS256 access tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Every environment other than local refuses to start while this still reads
# changethis. Rotating it invalidates all outstanding access tokens.
SECRET_KEY=changethis

# The remaining auth settings default to these values in
# backend/app/core/config.py; uncomment a line only to deviate from it.
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# PASSWORD_MIN_LENGTH=8
# EMAIL_RESET_TOKEN_EXPIRE_HOURS=1
# EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=48

# Refresh-token cookie. It is host-only and scoped to /api/v1/auth, so it is
# never sent to any other path or host. REFRESH_COOKIE_SECURE is derived from
# ENVIRONMENT (False locally over plain HTTP, True everywhere else); set it
# explicitly only when that inference is wrong for your setup. SameSite=none
# requires Secure — the backend refuses to start on that combination.
# REFRESH_COOKIE_NAME=wirksam_refresh
# REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_SECURE=True

# Platform superadmins, as a JSON list. Anyone signing in with one of these
# addresses is promoted to the global admin role on login; leaving it empty
# means the deployment has no superadmin at all.
# SUPERADMIN_EMAILS=["admin@example.com"]

# Who may create an account. The defaults are open signup, which is what the
# hosted instance runs; a self-hosted deployment can put a door on it.
#
# REGISTRATION_MODE
#   open      anyone can sign up and use the account straight away
#   approval  anyone can sign up, but the account waits until a superadmin
#             approves it under Admin -> Users
#   invite    only people holding an event invitation can sign up: the link they
#             were sent, or an open invitation addressed to their email
#
# REGISTRATION_ALLOWED_DOMAINS limits signup to these email domains,
# comma-separated (e.g. gemeinde.de,example.org). Empty means any domain.
#
# REGISTRATION_INVITE_BYPASS lets someone holding a valid invitation skip the
# approval queue and the domain list. Turn it off to make both apply to
# invited people too.
#
# The addresses in SUPERADMIN_EMAILS always get in, approved, whatever the mode,
# so a fresh deployment can still create the administrator who approves everyone
# else. Set SUPERADMIN_EMAILS before switching to "approval" or "invite".
REGISTRATION_MODE=open
REGISTRATION_ALLOWED_DOMAINS=
REGISTRATION_INVITE_BYPASS=true

# Cloudflare Turnstile — the bot check in front of the open registration form.
#
# Both halves come from one widget in the Cloudflare dashboard (Turnstile → Add
# widget); it is free and needs no DNS change, so the domain does not have to be
# on Cloudflare. The site key is public and is served to the browser through
# frontend/docker-entrypoint.sh; the secret stays here.
#
# Leave both empty to switch the check off — that is the default, and it is what
# local development and the E2E suite run with. The backend enforces the
# challenge only when TURNSTILE_SECRET_KEY is set, and it fails closed once it
# is: if Cloudflare cannot be reached, registration is refused rather than
# waved through.
#
# To exercise the real path locally, use Cloudflare's always-passes test pair
# (the dummy secret rejects real tokens and vice versa, so they must be set
# together — the site key belongs in frontend/public/config.js):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Demo sessions — the "check out a test event" button on the landing page.
#
# Pressing it mints a throwaway guest account, seeds it a whole event (tasks,
# shifts, teammates, bookings) and signs the visitor straight in. The account
# and everything it owns are hard-deleted once SANDBOX_TTL_MINUTES have passed.
#
# SANDBOX_ENABLED is read twice: the backend refuses the endpoint with a 404
# when it is false, and the same name is handed to the browser through
# frontend/docker-entrypoint.sh so the landing page does not render a button
# that cannot work. Set both or neither — they are one switch.
#
# SANDBOX_MAX_ACTIVE is a hard ceiling on live demos, counted in the database.
# It is the knob that keeps a seeded event per visitor from becoming a way to
# fill the disk; raise it for a busy deployment rather than switching it off.
SANDBOX_ENABLED=true
SANDBOX_TTL_MINUTES=60
SANDBOX_MAX_ACTIVE=25

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=8432
POSTGRES_DB=app
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

SENTRY_DSN=https://your-sentry-dsn

# Web Push (VAPID) — generate keys with:
# cd backend && uv run python -c "from py_vapid import Vapid; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; import base64; v = Vapid(); v.generate_keys(); pub = base64.urlsafe_b64encode(v._public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).rstrip(b'=').decode(); priv = base64.urlsafe_b64encode(v._private_key.private_numbers().private_value.to_bytes(32, 'big')).rstrip(b'=').decode(); print(f'VAPID_PRIVATE_KEY={priv}'); print(f'VAPID_PUBLIC_KEY={pub}')"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@example.com

# Telegram Bot — create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Legal / Impressum (injected at runtime into frontend config.js)
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_CITY=
LEGAL_EMAIL=
LEGAL_PHONE=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# API domain (used for Traefik routing of backend and frontend build arg)
API_DOMAIN=api.localhost
